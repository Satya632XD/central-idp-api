# =================================================================
# Central Identity Provider (IdP) - Environment Configuration
# =================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://auth.yourdomain.com
CORS_ORIGIN=*

# PostgreSQL Database (Hosted on Neon: https://neon.tech)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Redis Cache & Rate Limiting (Hosted on Upstash: https://upstash.com)
# Format: rediss://default:TOKEN@ENDPOINT.upstash.io:6379
REDIS_URL="rediss://default:your_upstash_redis_token@your-redis-endpoint.upstash.io:6379"

# Asymmetric RS256 JWT Token Configuration
# Run `npm run generate:keys` to generate a fresh pair
JWT_KEY_ID="kid_b40361c1e8876d1e"
JWT_ISSUER="https://auth.yourdomain.com"
JWT_AUDIENCE="central-idp-clients"
JWT_ACCESS_TOKEN_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TOKEN_TTL_DAYS=30          # 30 days
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCrLwAg006if4ZT\n...rest_of_key...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAqy8AINNOon+GU+Ap1539\n...rest_of_key...\n-----END PUBLIC KEY-----"

# AES-256-GCM Encryption Key for Secrets At Rest (32 bytes / 64 hex characters)
# Generated via: crypto.randomBytes(32).toString('hex')
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Admin API Key for Protected Operations (e.g., /admin/send-update)
ADMIN_API_KEY="your-high-entropy-admin-api-key-here"

# Transactional Email Service (Resend: https://resend.com)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuv"
RESEND_FROM_EMAIL="noreply@auth.yourdomain.com"

# SMS Service (Twilio: https://twilio.com)
# Swap interface with MSG91 or AWS SNS as desired
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+12345678901"

# WebAuthn / Passkeys Configuration (@simplewebauthn/server)
RP_NAME="Central Gaming IdP"
RP_ID="auth.yourdomain.com"              # Effective domain (e.g. localhost for dev, yourdomain.com for prod)
RP_ORIGIN="https://auth.yourdomain.com"  # Full origin including protocol and port
